  "player_messages": { "messages": [ { "turn": 1324941, "message": "You learned Crystallize Mana!", "count": 1, "type": 0 }, { "turn": 1324941, "message": "You learned Stormshaper Rune!", "count": 1, "type": 0 }, { "turn": 1324941, "message": "You learned Lightning Bolt!", "count": 1, "type": 0 }, { "turn": 1324941, "message": "You learned Windrunning!", "count": 1, "type": 0 }, { "turn": 1324800, "message": "<color_light_cyan>[System]</color> initialized. Welcome <color_white>[User]</color> of world IB-73758-R. Use your <color_light_cyan>[System Interface]</color> to access the <color_light_cyan>[System]</color>.", "count": 1, "type": 2 }, { "turn": 1324800, "message": "You have been an apprentice to a wizard for some time now, you've saved for years for your dream vacation at a secluded wizard tower.  Your journey of self-discovery is interrupted by the Cataclysm.  Now you have to figure out how to survive on your own.", "count": 1, "type": 5 }, { "turn": 1324802, "message": "From the southeast you hear Get out of here, stalker!", "count": 1, "type": 3 }, { "turn": 1324815, "message": "From the east you hear bang!", "count": 1, "type": 3 }, { "turn": 1324816, "message": "From the east you hear Empty your hands and hold your position, citizen!", "count": 1, "type": 4 }, { "turn": 1324818, "message": "From the east you hear \"My glasses! I can't live without my glasses!\"", "count": 1, "type": 4 }, { "turn": 1324824, "message": "Moving onto this sofa is slow!", "count": 1, "type": 3 }, { "turn": 1324826, "message": "Moving off of this sofa is slow!", "count": 1, "type": 3 }, { "turn": 1324828, "message": "Never mind.", "count": 2, "type": 5 }, { "turn": 1324835, "message": "You pick up: 1 Jedi Holocron: Form VI (unread)", "count": 1, "type": 5 }, { "turn": 1324838, "message": "Never mind.", "count": 2, "type": 5 }, { "turn": 1324839, "message": "Moving onto this chair is slow!", "count": 1, "type": 3 }, { "turn": 1324840, "message": "Moving off of this chair is slow!", "count": 1, "type": 3 }, { "turn": 1324842, "message": "Never mind.", "count": 1, "type": 5 }, { "turn": 1324843, "message": "You pick up: 1 Scroll of Wooden Shaft", "count": 1, "type": 5 }, { "turn": 1324846, "message": "You pick up: 1 Scroll of Haste", "count": 1, "type": 5 }, { "turn": 1324848, "message": "Never mind.", "count": 1, "type": 5 }, { "turn": 1324849, "message": "You start running.", "count": 1, "type": 5 }, { "turn": 1324849, "message": "You start crouching.", "count": 1, "type": 5 }, { "turn": 1324854, "message": "From the east you hear bang!", "count": 1, "type": 3 }, { "turn": 1324857, "message": "You can't go down here!", "count": 1, "type": 4 }, { "turn": 1324869, "message": "Spotted peace officer--safe mode is on!  (Press ! to turn it off, press ' to ignore monster)", "count": 1, "type": 3 }, { "turn": 1324869, "message": "Safe mode OFF!", "count": 1, "type": 4 }, { "turn": 1324870, "message": "The peace officer shoots the deer.", "count": 1, "type": 5 }, { "turn": 1324871, "message": "From the east and below you hear bang!", "count": 1, "type": 3 }, { "turn": 1324894, "message": "Moving onto this bed is slow!", "count": 1, "type": 3 }, { "turn": 1324894, "message": "You see here 1 <color_c_light_green>|| </color>blanket.", "count": 1, "type": 5 }, { "turn": 1324900, "message": "Moving onto this bed is slow!", "count": 1, "type": 3 }, { "turn": 1324905, "message": "Moving off of this bed is slow!", "count": 1, "type": 3 }, { "turn": 1324909, "message": "Moving onto this indoor plant is slow!", "count": 1, "type": 3 }, { "turn": 1324913, "message": "Moving off of this indoor plant is slow!", "count": 1, "type": 3 }, { "turn": 1324917, "message": "Moving onto this chair is slow!", "count": 1, "type": 3 }, { "turn": 1324919, "message": "Moving off of this chair is slow!", "count": 1, "type": 3 }, { "turn": 1324939, "message": "From the southeast and above you hear Devon Cerda, magus saying \"What was that?\"", "count": 1, "type": 4 }, { "turn"