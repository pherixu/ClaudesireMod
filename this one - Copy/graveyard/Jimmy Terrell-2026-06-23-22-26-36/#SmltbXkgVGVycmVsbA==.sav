  "player_messages": { "messages": [ { "turn": 7804800, "message": "<color_light_cyan>[System]</color> initialized. Welcome <color_white>[User]</color> of world IB-73758-R. Use your <color_light_cyan>[System Interface]</color> to access the <color_light_cyan>[System]</color>.", "count": 1, "type": 2 }, { "turn": 7804800, "message": "When the apocalypse broke out, you were funneled into the nearest shelter.  Here you have lived, never leaving, lest the unknowns of the outside world hurt you.  Supplies are running low, and for the first time since the Cataclysm, you will be forced to face the outside world.", "count": 1, "type": 5 }, { "turn": 7804805, "message": "Moving onto this bed is slow!", "count": 2, "type": 3 }, { "turn": 7804805, "message": "You see here 1 <color_c_light_green>|| </color>down-filled blanket.", "count": 1, "type": 5 }, { "turn": 7804808, "message": "Moving off of this bed is slow!", "count": 1, "type": 3 }, { "turn": 7804810, "message": "Never mind.", "count": 1, "type": 5 }, { "turn": 7804811, "message": "It takes you a couple seconds to wield your M1 Garand clip.", "count": 1, "type": 5 }, { "turn": 7804818, "message": "You reload the M1 Garand clip.", "count": 1, "type": 5 }, { "turn": 7804818, "message": "You don't have any .30-06 Springfield to reload your M1 Garand clip!", "count": 2, "type": 4 }, { "turn": 7804818, "message": "It takes you a couple seconds to wield your <color_c_light_green>|| </color>M1 Garand+1.", "count": 1, "type": 5 }, { "turn": 7804825, "message": "Can't reload the <color_c_light_green>|| </color>M1 Garand+1.", "count": 1, "type": 4 }, { "turn": 7804827, "message": "Moving onto this bed is slow!", "count": 1, "type": 3 }, { "turn": 7804827, "message": "You see here 1 <color_c_light_green>|| </color>down-filled blanket.", "count": 1, "type": 5 }, { "turn": 7804829, "message": "Moving off of this bed is slow!", "count": 1, "type": 3 }, { "turn": 7804834, "message": "Never mind.", "count": 2, "type": 5 }, { "turn": 7804840, "message": "Never mind.", "count": 1, "type": 5 }, { "turn": 7804840, "message": "You put on your <color_c_light_green>|| </color>cowboy hat (poor fit).", "count": 1, "type": 5 }, { "turn": 7804858, "message": "Moving onto this chair is slow!", "count": 1, "type": 3 }, { "turn": 7804859, "message": "Moving onto this floor lamp (no power) is slow!", "count": 1, "type": 3 }, { "turn": 7804861, "message": "Moving off of this floor lamp (no power) is slow!", "count": 1, "type": 3 }, { "turn": 7804863, "message": "Never mind.", "count": 1, "type": 5 }, { "turn": 7804866, "message": "Moving onto this chair is slow!", "count": 1, "type": 3 }, { "turn": 7804867, "message": "Moving onto this table is slow!", "count": 1, "type": 3 }, { "turn": 7804867, "message": "You see here 1 steak knife.", "count": 1, "type": 5 }, { "turn": 7804869, "message": "Moving off of this table is slow!", "count": 1, "type": 3 }, { "turn": 7804871, "message": "Moving off of this chair is slow!", "count": 1, "type": 3 }, { "turn": 7804877, "message": "Never mind.", "count": 1, "type": 5 }, { "turn": 7804881, "message": "Moving onto this cupboard is slow!", "count": 1, "type": 3 }, { "turn": 7804881, "message": "You see here 1 steak knife.", "count": 1, "type": 5 }, { "turn": 7804882, "message": "Moving off of this cupboard is slow!", "count": 1, "type": 3 }, { "turn": 7804884, "message": "Moving onto this sink is slow!", "count": 1, "type": 3 }, { "turn": 7804887, "message": "Moving off of this sink is slow!", "count": 1, "type": 3 }, { "turn": 7804892, "message": "Never mind.", "count": 1, "type": 5 }, { "turn": 7804901, "message": "Never mind.", "count": 1, "type": 5 }, { "turn": 7804931, "message": "Never mind.", "count": 1, "type": 5 }, { "turn": 7804937, "message": "Never mind.", "count": 2, "type": 5 }, { "turn": 7804942, "message": "Never mind.", "count": 2, "type": 5 }, { "turn": 7804952, "message": "Never mind.", "count": 1, "type": 5 }, { "turn": 7804979, "message": "Never mind.",