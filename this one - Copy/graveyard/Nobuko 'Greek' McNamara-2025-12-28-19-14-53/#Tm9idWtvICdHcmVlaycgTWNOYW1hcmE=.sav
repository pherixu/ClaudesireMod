  "player_messages": { "messages": [ { "turn": 1324800, "message": "<color_light_cyan>[System]</color> initialized. Welcome <color_white>[User]</color> of world IB-73758-R. Use your <color_light_cyan>[System Interface]</color> to access the <color_light_cyan>[System]</color>.", "count": 1, "type": 2 }, { "turn": 1324800, "message": "Once it became clear that the world was ending you took to the skies, hoping that your flying skills could lead you to safety.  With no safe landing zones, knowing fuel will soon be a concern, you made a quick landing to plan your next move.", "count": 1, "type": 5 }, { "turn": 1324818, "message": "You open the Medevac helicopter's sliding door.", "count": 1, "type": 5 }, { "turn": 1324819, "message": "Moving onto this <color_c_light_green>||</color> sliding door is slow!", "count": 1, "type": 3 }, { "turn": 1324823, "message": "Never mind.", "count": 1, "type": 5 }, { "turn": 1324823, "message": "Moving onto this <color_c_light_green>||</color> seat is slow!", "count": 1, "type": 3 }, { "turn": 1324823, "message": "There are vehicle controls here.", "count": 1, "type": 5 }, { "turn": 1324823, "message": "Press ^ or CTRL+A to drive.", "count": 1, "type": 4 }, { "turn": 1324829, "message": "You close the Medevac helicopter's <color_c_light_green>||</color> sliding door.", "count": 1, "type": 5 }, { "turn": 1324830, "message": "Never mind.", "count": 1, "type": 5 }, { "turn": 1324830, "message": "Moving off of this <color_c_light_green>||</color> seat is slow!", "count": 1, "type": 3 }, { "turn": 1324832, "message": "Never mind.", "count": 3, "type": 5 }, { "turn": 1324832, "message": "You open the Medevac helicopter's internal door.", "count": 1, "type": 5 }, { "turn": 1324833, "message": "You add roads and points of interest to your map.", "count": 1, "type": 0 }, { "turn": 1324837, "message": "You close the Medevac helicopter's <color_c_light_green>||</color> internal door.", "count": 1, "type": 5 }, { "turn": 1324838, "message": "Moving onto this <color_c_light_green>||</color> seat is slow!", "count": 1, "type": 3 }, { "turn": 1324838, "message": "There are vehicle controls here.", "count": 1, "type": 5 }, { "turn": 1324838, "message": "Press ^ or CTRL+A to drive.", "count": 1, "type": 4 }, { "turn": 1324841, "message": "You close the Medevac helicopter's <color_c_light_green>||</color> sliding door.", "count": 1, "type": 5 }, { "turn": 1324842, "message": "Moving off of this <color_c_light_green>||</color> seat is slow!", "count": 1, "type": 3 }, { "turn": 1324844, "message": "Moving onto this <color_c_light_green>||</color> seat is slow!", "count": 1, "type": 3 }, { "turn": 1324844, "message": "There are vehicle controls here.", "count": 1, "type": 5 }, { "turn": 1324844, "message": "Press ^ or CTRL+A to drive.", "count": 1, "type": 4 }, { "turn": 1324847, "message": "You take control of the Medevac helicopter.", "count": 1, "type": 5 }, { "turn": 1324847, "message": "The Medevac helicopter's engines start up.", "count": 1, "type": 5 }, { "turn": 1324856, "message": "You steer the vehicle into an ascent.", "count": 10, "type": 4 }, { "turn": 1324857, "message": "It would be unsafe to try and ascend further.", "count": 1, "type": 1 }, { "turn": 1324858, "message": "Can't aim turrets: all turrets are offline or set to automatic targeting mode.", "count": 1, "type": 3 }, { "turn": 1324858, "message": "Never mind.", "count": 1, "type": 5 }, { "turn": 1324878, "message": "You steer the vehicle into a descent.", "count": 7, "type": 4 }, { "turn": 1324884, "message": "You steer the vehicle into a descent.", "count": 1, "type": 4 }, { "turn": 1324886, "message": "You steer the vehicle into an ascent.", "count": 2, "type": 4 }, { "turn": 1324887, "message": "You steer the vehicle into a descent.", "count": 1, "type": 4 }, { "turn": 1324889, "message": "You steer the vehicle into an ascent.", "count": 2, "type": 4 }, { "turn": 1324890, "message": "You steer the vehicle into a descent.", "count": 1, "typ