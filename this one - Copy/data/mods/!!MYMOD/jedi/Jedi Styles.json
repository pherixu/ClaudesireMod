  {
    "type": "martial_art",
    "id": "style_mma_makashi",
    "name": { "str": "Makashi" },
    "description": "A style regarded for its elegance, graceful presentation, and balletic approach in wielding a lightsaber. It is excellent for saber-to-saber combat, and was developed to combat the rise of enemy lightsaber wielders. It was notable for its primary focus on facing a single opponent, preventing disarmament, and quick, very precise strikes. However, it is poorly suited for multiple enemies and defense against long-range attacks.",
    "initiate": [
      "You adopt a narrow stance, blade angled forward with surgical precision.",
      "%s adopts a narrow dueling stance."
    ],
    "learn_difficulty": 9,
    "primary_skill": "cutting",
    "strictly_melee": true,
    "static_buffs": [
      {
        "id": "mma_buff_makashi_static1",
        "name": "Duelist Training",
        "description": "+Accuracy, reduced move cost.",
        "melee_allowed": true,
		"skill_requirements": [ { "name": "spellcraft", "level": 2 } ],
        "flat_bonuses": [
          { "stat": "hit", "scaling-stat": "per", "scale": 0.5 }
        ],
		"mult_bonuses": [ { "stat": "movecost", "scale": 0.90 } ]
      }
	  ],
	"onmove_buffs": [
      {
        "id": "mma_buff_makashi_move",
        "name": "Elegant footwork",
		"description": "Makashi, \"The Way of the Ysalamiri\", emphasizes precision, footwork, and efficiency. Designed primarily for lightsaber dueling, Makashi sacrifices crowd control for deadly accuracy against single opponents.",       "skill_requirements": [ { "name": "melee", "level": 2 } ],
        "melee_allowed": true,
		"buff_duration": 3,
	    "max_stacks": 3,
        "flat_bonuses": [
          { "stat": "arpen", "type": "cut", "scaling-stat": "per", "scale": 1.0 },
          { "stat": "arpen", "type": "bash", "scaling-stat": "per", "scale": 1.0 },
          { "stat": "arpen", "type": "stab", "scaling-stat": "per", "scale": 1.0 },
          { "stat": "arpen", "type": "heat", "scaling-stat": "per", "scale": 1.0 }
        ]
	  }
	  ],
  "onmiss_buffs": [
    {
      "id": "mma_buff_makashi_miss",
      "name": "Flowing blade",
      "description": "Your blade is in constant motion.",
      "melee_allowed": true,
      "skill_requirements": [
        { "name": "melee", "level": 2 },
        { "name": "spellcraft", "level": 2 }
      ],
      "buff_duration": 3,
      "flat_bonuses": [
        { "stat": "hit", "scaling-stat": "per", "scale": 0.5 },
