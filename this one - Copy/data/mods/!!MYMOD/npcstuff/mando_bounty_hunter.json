      "ORIGIN_SECONDARY"
    ],
    "dialogue": {
      "describe": "You catch the faint glint of beskar in the corner of your eye, like someone is tracking the same prey as you...",
      "offer": "Another of my clan went dark near here. Find them with me and the bounty is as good as split.",
      "accepted": "This is the way.",
      "rejected": "Then we hunt separately. Stay out of my sights.",
      "advice": "Keep your head down and your blaster charged. Whatever took my clansman is still out there.",
      "inquire": "Have you found my clansman yet?",
      "success": "Good. Two hunters beat one. Let's get paid.",
      "success_lie": "I've hunted liars before. Try again.",
      "failure": "Giving up already? Coward."
    }
