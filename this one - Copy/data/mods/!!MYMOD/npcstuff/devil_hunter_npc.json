    "origins": [ "ORIGIN_SECONDARY" ],
    "dialogue": {
      "describe": "You catch a whiff of gun smoke and cheap cologne.  Somebody stylish is about to make a mess.",
      "offer": "Got a buddy who owes me a slice.  Another hunter, same line of work, worse taste in coats.  Find 'em with me and we'll have a real party.",
      "accepted": "Now we're talking.  Try to keep up.",
      "rejected": "Your loss, kid.  The party's still on without you.",
      "advice": "Look for the fireworks.  Wherever there's smoke, there's a devil, and wherever there's a devil, there's a hunter.",
      "inquire": "Found my buddy yet?.",
      "success": "Ha!  Now that's what I call a party!  Two hunters on the job.",
      "success_lie": "Nice try.  That's no hunter of mine.  Not enough style.",
      "failure": "Bored already?  Yeah, me too.  Whatever."
    }
  },

